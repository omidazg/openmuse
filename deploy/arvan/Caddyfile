# Caddy obtains and renews the HTTPS certificate for $DOMAIN automatically.
# The DNS A record must point at the server or at the ArvanCloud CDN edge, which then reaches
# this origin over the visitor's scheme (upstream "auto"), so the ACME HTTP-01 challenge still
# arrives on port 80 (see README.fa.md, section 5).
{
	# Clients send no SNI when connecting to a bare IP; serve that IP's certificate then.
	# compose sets DEFAULT_SNI to SERVER_IP, or to DOMAIN when SERVER_IP is empty.
	default_sni {$DEFAULT_SNI}
	servers {
		# ArvanCloud CDN edges (https://www.arvancloud.ir/fa/ips.txt): trust the visitor address
		# they put in X-Forwarded-For, read right to left, so {client_ip} is the visitor.
		trusted_proxies static 185.143.232.0/22 188.229.116.16/30 94.101.182.0/27 2.144.3.128/28 37.32.16.0/27 37.32.17.0/27 37.32.18.0/27 37.32.19.0/27 185.215.232.0/22 178.131.120.48/28 94.101.183.0/28 78.157.36.112/28 95.38.61.80/28 193.24.119.0/29
		trusted_proxies_strict
	}
}

# DOMAIN may also be the bare server IP (e.g. while a domain is filtered or not yet
# registered): Let's Encrypt issues IP certificates only with ACME_PROFILE=shortlived.
{$DOMAIN} {
	tls {
		issuer acme {
			profile {$ACME_PROFILE:classic}
		}
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# The CDN edge must pass SSE chat streams through unbuffered as well.
	header /api/* X-Accel-Buffering no
	# Agent chat uses SSE; never buffer it.
	reverse_proxy app:8787 {
		flush_interval -1
		# The API rate-limits by this address; it overwrites anything the client sent.
		header_up X-Real-IP {client_ip}
	}
}

# With a domain in DOMAIN, SERVER_IP keeps old bare-IP links working: they get a 6-day IP
# certificate and a redirect to the domain. Empty SERVER_IP leaves a certificate-less
# catch-all here, so a DOMAIN that is itself the IP keeps serving the app above.
https://{$SERVER_IP} {
	tls {
		issuer acme {
			profile shortlived
		}
	}
	redir https://{$DOMAIN}{uri} permanent
}

# Every other hostname on plain HTTP goes to the primary domain with its path: www and the
# other TLDs (the CDN edge terminates their TLS and reaches this origin over HTTP), plus
# http:// visits to DOMAIN itself. ACME HTTP-01 challenges are answered before this route.
http:// {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	redir https://{$DOMAIN}{uri} permanent
}
