# Copy to deploy/arvan/.env on the server (chmod 600). Never commit the real file.

# Public hostname served by Caddy (A record -> server IP).
DOMAIN=muse.example.ir

# Optional mirrors (useful on Iran-region servers). REGISTRY_MIRROR must end with "/".
# REGISTRY_MIRROR=docker.arvancloud.ir/
# NPM_REGISTRY=https://registry.npmjs.org/

# --- Secrets (generate, see README.fa.md) ---
# openssl rand -hex 24
OPENMUSE_ACCESS_KEY=
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32
WORKER_TOKEN=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- ذخیرهٔ گفت‌وگوها (Threads) ---
# local: گفت‌وگوها (اصلی و جانبی، تغییر نام، بایگانی/بازگردانی) در همین Postgres ذخیره می‌شوند؛
#        بدون نیاز به CopilotKit Cloud — مناسب سرورهای ایران.
# intelligence: CopilotKit Intelligence (سرویس ابری؛ نیازمند CPK_INTELLIGENCE_API_KEY).
# اگر خالی بماند: با وجود کلید CPK ← intelligence، وگرنه ← local.
THREADS_BACKEND=local

# CopilotKit Intelligence (اختیاری؛ فقط برای THREADS_BACKEND=intelligence):
# npx copilotkit@latest login && npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# --- Model provider ---
# متیس (Metis AI، https://metisai.ir): درگاه ایرانی مدل‌ها؛ برای سرورهای داخل ایران که OpenAI/Anthropic/Google
# آی‌پی آن‌ها را مسدود می‌کنند. با تنظیم این کلید، همهٔ مدل‌های openai/، anthropic/ و google/ از متیس عبور
# می‌کنند و OPENAI_API_KEY/OPENAI_BASE_URL دیگر لازم نیست. مدل پیشنهادی: MODEL=openai/gpt-4.1
METIS_API_KEY=
# METIS_BASE_URL=https://api.metisai.ir
AGENT_BACKEND=model
MODEL=openai/your-model-id
OPENAI_API_KEY=
# OpenAI-compatible gateway (needed when the server's IP is blocked by the provider):
# OPENAI_BASE_URL=https://your-gateway.example/v1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Or an external AG-UI agent:
# AGENT_BACKEND=agui
# AGENT_URL=
# AGENT_TOKEN=

# --- Optional Google Workspace (OAuth redirect: https://$DOMAIN/api/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
