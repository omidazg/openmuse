# Copy to deploy/arvan/.env on the server (chmod 600). Never commit the real file.

# Public hostname served by Caddy (A record -> server IP).
DOMAIN=muse.example.ir
# پروفایل گواهی Let's Encrypt: classic برای دامنه؛ shortlived فقط وقتی DOMAIN خودِ IP سرور است
# (گواهی ۶ روزه). set-domain.sh این مقدار را خودکار تنظیم می‌کند.
ACME_PROFILE=classic

# Optional mirrors (useful on Iran-region servers). REGISTRY_MIRROR must end with "/".
# REGISTRY_MIRROR=docker.arvancloud.ir/
# NPM_REGISTRY=https://registry.npmjs.org/

# --- Secrets (generate, see README.fa.md) ---
# openssl rand -hex 24
OPENMUSE_ACCESS_KEY=
# کلیدهای جداگانه برای هر کاربر؛ هر کلید فضای کاری مستقل خودش را دارد:
# OPENMUSE_USER_KEYS=ali:<openssl rand -hex 24>,sara:<openssl rand -hex 24>
OPENMUSE_USER_KEYS=
# کاربران تازه را می‌توانید از داخل برنامه بسازید: منو ← «مدیریت کاربران» (فقط برای مدیر).
# کلید این کاربران فقط به‌صورت هش در پایگاه داده ذخیره می‌شود و فقط یک بار نمایش داده می‌شود.

# --- سقف مصرف روزانه (برای هر کاربر غیرمدیر؛ ۰ یعنی نامحدود) ---
# سقف‌ها نیمه‌شب به وقت تهران صفر می‌شوند و مدیر می‌تواند برای هر کاربر سقف جداگانه بگذارد.
DAILY_MESSAGE_LIMIT=200
DAILY_TASK_LIMIT=30

# --- ورود با پیامک (اختیاری؛ کاوه‌نگار، Verify Lookup) ---
# فقط وقتی فعال می‌شود که هر دو مقدار تنظیم شده باشند. قالب باید در پنل کاوه‌نگار تأییدشده باشد
# و یک متغیر %token% برای کد داشته باشد. شمارهٔ هر کاربر را مدیر در «مدیریت کاربران» ثبت می‌کند.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=
# true: شماره‌های ثبت‌نشده با اولین ورود موفق، خودکار یک کاربر رایگان می‌سازند.
OTP_SIGNUP=false

# --- اشتراک و پرداخت آنلاین (اختیاری؛ زرین‌پال) ---
# تا وقتی مرچنت خالی است، پرداخت آنلاین خاموش است و بخش «اشتراک» در برنامه دیده نمی‌شود.
# مرچنت ۳۶ نویسه‌ای را از پنل زرین‌پال بگیرید؛ دامنهٔ ثبت‌شده در زرین‌پال باید همان DOMAIN باشد.
ZARINPAL_MERCHANT_ID=
# true: درگاه آزمایشی sandbox.zarinpal.com (هر UUID دلخواه به‌عنوان مرچنت پذیرفته می‌شود).
ZARINPAL_SANDBOX=false
# طرح‌ها به‌صورت JSON؛ قیمت به تومان برای هر دوره. خالی: «رایگان» و «حرفه‌ای» (۱۹۹٬۰۰۰ تومان، ۳۰ روز،
# ۱۰۰۰ پیام و ۱۰۰ کار در روز). سقف خالی یعنی سقف پیش‌فرض بالا و ۰ یعنی نامحدود. «models» (اختیاری)
# فهرست مدل‌های مجاز هر طرح است و باید از فهرست MODELS باشد. سقف جداگانهٔ مدیر برای هر کاربر همیشه مقدم است.
# PLANS=[{"id":"free","name":"رایگان","price":0,"models":["openai/gpt-4.1-mini"]},{"id":"pro","name":"حرفه‌ای","price":199000,"days":30,"dailyMessages":1000,"dailyTasks":100}]
PLANS=

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32
WORKER_TOKEN=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- ذخیرهٔ گفت‌وگوها (Threads) ---
# local: گفت‌وگوها (اصلی و جانبی، تغییر نام، بایگانی/بازگردانی) در همین Postgres ذخیره می‌شوند؛
#        بدون نیاز به CopilotKit Cloud — مناسب سرورهای ایران.
# intelligence: CopilotKit Intelligence (سرویس ابری؛ نیازمند CPK_INTELLIGENCE_API_KEY).
# اگر خالی بماند: با وجود کلید CPK ← intelligence، وگرنه ← local.
THREADS_BACKEND=local

# CopilotKit Intelligence (اختیاری؛ فقط برای THREADS_BACKEND=intelligence):
# npx copilotkit@latest login && npx copilotkit@latest project select
CPK_INTELLIGENCE_API_KEY=

# --- Model provider ---
# متیس (Metis AI، https://metisai.ir): درگاه ایرانی مدل‌ها؛ برای سرورهای داخل ایران که OpenAI/Anthropic/Google
# آی‌پی آن‌ها را مسدود می‌کنند. با تنظیم این کلید، همهٔ مدل‌های openai/، anthropic/ و google/ از متیس عبور
# می‌کنند و OPENAI_API_KEY/OPENAI_BASE_URL دیگر لازم نیست. مدل پیشنهادی: MODEL=openai/gpt-4.1
METIS_API_KEY=
# METIS_BASE_URL=https://api.metisai.ir
AGENT_BACKEND=model
MODEL=openai/your-model-id
OPENAI_API_KEY=
# OpenAI-compatible gateway (needed when the server's IP is blocked by the provider):
# OPENAI_BASE_URL=https://your-gateway.example/v1
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# --- انتخاب مدل در گفت‌وگو ---
# فهرست مدل‌هایی که کاربران می‌توانند در گفت‌وگو انتخاب کنند، به شکل «شناسه:برچسب فارسی» و جداشده با ویرگول انگلیسی.
# MODEL همیشه پیش‌فرض است و اگر در این فهرست نباشد، خودکار با برچسب «مدل پیش‌فرض» اضافه می‌شود.
# شناسه‌های زیر در مهر ۱۴۰۵ روی متیس آزمایش شده‌اند. انتخاب هر کاربر روی سرور ذخیره می‌شود و برای کارهای
# واگذارشده هم به کار می‌رود؛ سرور هر شناسهٔ خارج از این فهرست را رد می‌کند.
MODELS=anthropic/claude-sonnet-5:کلاد سونت ۵ (قوی),openai/gpt-4.1-mini:جی‌پی‌تی ۴٫۱ مینی (سریع و ارزان),google/gemini-2.5-flash:جمنای ۲٫۵ فلش
# اختیاری: اگر یک مدل سریعِ موجود در MODELS را اینجا بنویسید، گزینهٔ «خودکار» هم نمایش داده می‌شود؛ پیام‌های کوتاه
# یک‌خطی بدون پیوند با مدل سریع و بقیهٔ پیام‌ها و همهٔ کارهای واگذارشده با MODEL پاسخ داده می‌شوند.
# MODEL_FAST=openai/gpt-4.1-mini

# --- ورودی صوتی (دکمهٔ میکروفون در گفت‌وگو) ---
# صدا به /audio/transcriptions سازگار با OpenAI (از طریق متیس) فرستاده می‌شود. روی متیس whisper-1 کار می‌کند؛
# gpt-4o-transcribe فعلاً فایل‌های مرورگر را رد می‌کند. ضبط‌های MP4 سافاری با gemini-2.5-flash تبدیل می‌شوند.
TRANSCRIBE_MODEL=whisper-1
# برای خاموش کردن دکمهٔ میکروفون: false
TRANSCRIBE_ENABLED=true

# Or an external AG-UI agent:
# AGENT_BACKEND=agui
# AGENT_URL=
# AGENT_TOKEN=

# --- Optional Google Workspace (OAuth redirect: https://$DOMAIN/api/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- ربات پیام‌رسان (اختیاری؛ راهنما: docs/BOT.fa.md) ---
# توکن ربات بله از @botfather در بله. خالی = ربات بله خاموش.
BALE_BOT_TOKEN=
# توکن ربات تلگرام از @BotFather در تلگرام. خالی = ربات تلگرام خاموش.
TELEGRAM_BOT_TOKEN=
# api.telegram.org از سرورهای ایران معمولاً در دسترس نیست. نشانی یک پراکسی معکوس (reverse proxy)
# که درخواست‌ها را بی‌تغییر به https://api.telegram.org می‌رساند، بدون / پایانی:
# TELEGRAM_API_BASE=https://tg-proxy.example.com
TELEGRAM_API_BASE=

# --- پشتیبان‌گیری روزانه (سرویس backup) ---
# هر روز ساعت ۰۰:۰۰ UTC (۰۳:۳۰ به وقت تهران) از Postgres (pg_dump -Fc) و volume داده‌های اپ
# (کلید امضای نشست و PDFها) نسخهٔ پشتیبان گرفته می‌شود: ۷ نسخهٔ روزانه و ۴ نسخهٔ هفتگی در
# volume «backups». نسخه‌های هفتگی hard link هستند و فضای اضافه نمی‌گیرند.
# BACKUP_ENABLED=1
# BACKUP_TIME_UTC=00:00
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# روز نسخهٔ هفتگی: ۱=دوشنبه … ۵=جمعه
# BACKUP_WEEKLY_DAY=5
# BACKUP_APP_DATA=1
# BACKUP_RUN_ON_START=0
# فضای ذخیره‌سازی ابری ابرآروان (S3). اگر هر چهار مقدار پر باشند، هر نسخه بارگذاری می‌شود و
# نسخه‌های قدیمی‌تر از BACKUP_S3_RETENTION_DAYS روز از باکت حذف می‌شوند. باکت را خصوصی بسازید.
# نمونهٔ نشانی: https://s3.ir-thr-at1.arvanstorage.ir
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# BACKUP_S3_PREFIX=openmuse
# BACKUP_S3_RETENTION_DAYS=30

# --- پایش و هشدار (سرویس monitor) ---
# هر دقیقه: سلامت API، HTTPS و گواهی (از مسیر داخلی Caddy)، browser-worker، پُرشدن دیسک،
# کانتینرهای ناسالم و وضعیت آخرین پشتیبان. فقط هنگام تغییر وضعیت پیام فارسی می‌فرستد.
# تلگرام: api.telegram.org از ایران ممکن است مسدود باشد؛ با ALERT_TELEGRAM_API_URL نشانی یک
# پراکسی Bot API را بدهید.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# ALERT_TELEGRAM_API_URL=https://api.telegram.org
# بله: از داخل ایران در دسترس است؛ توکن را از @BotFather در بله بگیرید.
ALERT_BALE_BOT_TOKEN=
ALERT_BALE_CHAT_ID=
# وب‌هوک عمومی: بدنهٔ JSON با فیلدهای text، status (down/up/info)، check و domain
ALERT_WEBHOOK_URL=
# نام نمایشی در پیام‌ها (پیش‌فرض: دستیار جی‌پی‌تی)
# ALERT_NAME=
# MONITOR_INTERVAL=60
# MONITOR_FAIL_THRESHOLD=2
# MONITOR_DISK_ALERT_PCT=90
# MONITOR_CERT_WARN_DAYS=2
# MONITOR_STARTUP_MESSAGE=1
# برای خاموش‌کردن بررسی کانتینرها (بدون دسترسی به Docker socket) مقدار /dev/null بگذارید:
# MONITOR_DOCKER_SOCKET_HOST=/var/run/docker.sock

# --- ثبت خطا (سازگار با Sentry، مثلاً GlitchTip خودمیزبان) ---
# خالی یعنی خاموش. فقط نوع خطا، پیام پاک‌سازی‌شده، stack و الگوی مسیر ارسال می‌شود؛
# بدنهٔ درخواست، سرآیندها و توکن‌ها هرگز ارسال نمی‌شوند.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# پیش‌فرض SENTRY_RELEASE: شناسهٔ commit که deploy.sh مستقر کرده است
# SENTRY_RELEASE=
