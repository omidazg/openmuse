{
  "name": "@openmuse/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "build:web": "expo export --platform web --output-dir dist/web",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:android": "expo export --platform android --output-dir dist/android",
    "typecheck": "tsc --noEmit",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@copilotkit/react-native": "1.73.0",
    "@expo-google-fonts/vazirmatn": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.24",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.11",
    "react-native-get-random-values": "~1.11.0",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@config-plugins/react-native-blob-util": "^14.0.2",
    "@config-plugins/react-native-pdf": "^14.0.2",
    "@types/react": "~19.2.18",
    "typescript": "~6.0.3"
  }
}
